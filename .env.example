# Supabase project (Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key-server-only

# Public address of this site, used for absolute artwork URLs sent to Breakin Bread
PUBLIC_SITE_URL=https://loop-records.vercel.app

# Partner sync with Breakin Bread. Leave off for now: the button and its section stay hidden.
PARTNER_SYNC=off

# Breakin Bread label import (bb-native: POST /api/admin/label-import)
BREAKINBREAD_IMPORT_URL=https://www.breakinbread.com/api/admin/label-import
# Same value as LOOP_IMPORT_SECRET on Breakin Bread. Generate with: openssl rand -hex 32
BREAKINBREAD_IMPORT_SECRET=
