{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/breakin-bread/push.js": { "includeFiles": "data/{catalog,artwork,cover-colors}.json" }
  },
  "headers": [
    { "source": "/art/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
